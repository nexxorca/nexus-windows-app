<Window x:Class="Nexus.App.Views.ActivityLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Desktop — Activity Log"
        Width="700" Height="450"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cmbFilter" Width="120" SelectionChanged="CmbFilter_SelectionChanged">
                <ComboBoxItem Content="All" IsSelected="True" Tag="all"/>
                <ComboBoxItem Content="Sync" Tag="sync"/>
                <ComboBoxItem Content="Uploads" Tag="uploads"/>
                <ComboBoxItem Content="Errors" Tag="errors"/>
            </ComboBox>
        </StackPanel>

        <ListView Grid.Row="1" x:Name="lstEvents">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time" Width="140"
                        DisplayMemberBinding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"/>
                    <GridViewColumn Header="Type" Width="120"
                        DisplayMemberBinding="{Binding Type}"/>
                    <GridViewColumn Header="Description" Width="320"
                        DisplayMemberBinding="{Binding Description}"/>
                    <GridViewColumn Header="Status" Width="60"
                        DisplayMemberBinding="{Binding Status}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Refresh" Width="80" Margin="0,0,10,0" Click="BtnRefresh_Click"/>
            <Button Content="Close" Width="80" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
