<Window x:Class="Nexus.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Desktop — Settings"
        Width="350" Height="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Sync Interval (seconds)" Margin="0,0,0,3"/>
        <TextBox Grid.Row="2" x:Name="txtInterval" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="Lookback Window (minutes)" Margin="0,0,0,3"/>
        <TextBox Grid.Row="4" x:Name="txtLookback" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Save" Width="80" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
