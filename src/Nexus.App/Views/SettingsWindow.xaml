<Window x:Class="Nexus.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Desktop — Settings"
        Width="350" Height="255"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Sync Interval (seconds)" Margin="0,0,0,3"/>
        <TextBox Grid.Row="2" x:Name="txtInterval" Margin="0,0,0,10"/>

        <CheckBox Grid.Row="3" x:Name="chkLaunchOnStartup" Content="Launch on startup" Margin="0,0,0,10"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="lblVersion" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save" Width="80" Margin="0,0,10,0" Click="BtnSave_Click"/>
                <Button Content="Cancel" Width="80" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
